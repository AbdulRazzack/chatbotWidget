{
  "name": "vetting-chat-widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable React chat widget for VETTING.com (public, client and candidate sites)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mock": "node mock-gateway/server.js",
    "start": "concurrently -n gateway,widget -c blue,green \"npm:mock\" \"npm:dev\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
