# Token server configuration (server/token-server.js). Copy to .env and fill in. NEVER commit .env.

PORT=8787

# Sites allowed to call /token (comma-separated)
ALLOWED_ORIGINS=https://www.vetting.com,https://portal.vetting.com,https://candidate.vetting.com

# Regional Direct Line endpoint for the Copilot Studio environment
DIRECTLINE_DOMAIN=https://europe.directline.botframework.com/v3/directline

# One Direct Line secret per front agent
# Copilot Studio → agent → Settings → Security → Web channel security → Secrets
DIRECTLINE_SECRET_PUBLIC=
DIRECTLINE_SECRET_CLIENT=
DIRECTLINE_SECRET_CANDIDATE=

# Portal login tokens (agree the format with VETTING's dev team)
PORTAL_JWKS_URL=
PORTAL_ISSUER=
PORTAL_AUDIENCE=
PORTAL_ROLE_CLAIM=vetting_role

# LOCAL TESTING ONLY: accept the dev page's fake client/candidate logins. Leave unset in production.
# Also allows http://localhost origins. Must not be combined with PORTAL_JWKS_URL.
DEV_TEST_LOGINS=
